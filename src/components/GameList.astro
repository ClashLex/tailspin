---
import GameCard from './GameCard.astro';
import EmptyState from './EmptyState.astro';
import type { Game } from '../types/game';

interface TaxonomyOption {
  id: number;
  name: string;
}

interface Props {
  games: Game[];
  categories: TaxonomyOption[];
  publishers: TaxonomyOption[];
  currentPage: number;
  totalPages: number;
  totalGames: number;
}

const { games, categories, publishers, currentPage, totalPages, totalGames } = Astro.props;
const pagePath = (page: number): string => page === 1 ? '/' : `/games/page/${page}`;
---

{totalGames === 0 ? (
  <EmptyState text="No games available at the moment." />
) : (
  <>
    <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters" aria-label="Filter games">
      <div class="grid gap-6 md:grid-cols-[2fr_1fr_auto] md:items-end">
        <fieldset>
          <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label class="flex items-center gap-2 text-sm text-slate-300">
                <input
                  type="checkbox"
                  value={category.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-testid={`category-filter-${category.id}`}
                />
                {category.name}
              </label>
            ))}
          </div>
        </fieldset>
        <label class="text-sm font-medium text-slate-200" for="publisher-filter">
          Publisher
          <select id="publisher-filter" class="mt-2 block w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" data-testid="publisher-filter">
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </label>
        <button type="reset" class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none" data-testid="clear-filters">
          Clear filters
        </button>
      </div>
      <p class="mt-4 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-results-count"></p>
    </form>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
      {games.map((game) => <GameCard game={game} />)}
    </div>
    <div class="hidden" data-testid="no-filter-results"><EmptyState text="No games match those filters." /></div>

    {totalPages > 1 && (
      <nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Game list pagination" data-testid="pagination">
        {currentPage > 1 ? (
          <a
            href={pagePath(currentPage - 1)}
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="pagination-previous"
          >
            Previous
          </a>
        ) : (
          <span class="cursor-not-allowed rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-500" aria-disabled="true" data-testid="pagination-previous">
            Previous
          </span>
        )}
        <div class="flex items-center gap-1" aria-label="Pages">
          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            page === currentPage ? (
              <span class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white" aria-current="page" data-testid={`pagination-page-${page}`}>
                {page}
              </span>
            ) : (
              <a
                href={pagePath(page)}
                class="rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid={`pagination-page-${page}`}
              >
                {page}
              </a>
            )
          ))}
        </div>
        {currentPage < totalPages ? (
          <a
            href={pagePath(currentPage + 1)}
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="pagination-next"
          >
            Next
          </a>
        ) : (
          <span class="cursor-not-allowed rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-500" aria-disabled="true" data-testid="pagination-next">
            Next
          </span>
        )}
      </nav>
    )}
  </>
)}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const count = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const empty = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  const applyFilters = (): void => {
    const selectedCategories = new Set(
      [...document.querySelectorAll<HTMLInputElement>('[data-testid^="category-filter-"]:checked')].map((input) => input.value),
    );
    const publisher = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]')?.value ?? '';
    let visible = 0;

    cards.forEach((card) => {
      const matchesCategory = selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const matchesPublisher = publisher === '' || publisher === card.dataset.publisherId;
      const matches = matchesCategory && matchesPublisher;
      card.hidden = !matches;
      if (matches) visible += 1;
    });

    if (count) count.textContent = `${visible} ${visible === 1 ? 'game' : 'games'} shown`;
    empty?.classList.toggle('hidden', visible > 0);
  };

  form?.addEventListener('change', applyFilters);
  form?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
  applyFilters();
</script>
