---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GameList from '../components/GameList.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getGamesPage } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const allGames = await getAllGames(db);
const gamePage = await getGamesPage(db, { page: 1 });
const categories = [...new Map(
  allGames.filter((game) => game.category).map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  allGames.filter((game) => game.publisher).map((game) => [game.publisher!.id, game.publisher!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <GameList
        games={gamePage.games}
        categories={categories}
        publishers={publishers}
        currentPage={gamePage.page}
        totalPages={gamePage.totalPages}
        totalGames={gamePage.totalGames}
      />
    </div>
  </div>
</Layout>
